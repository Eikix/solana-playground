{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"assist": {
		"enabled": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.js",
			"**/*.json",
			"!node_modules",
			"!target",
			"!dist",
			"!.anchor",
			"!test-ledger"
		]
	}
}
