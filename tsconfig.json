{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": ".",
		"declaration": true,
		"resolveJsonModule": true,
		"types": ["bun-types"]
	},
	"include": ["tests/**/*.ts", "scripts/**/*.ts"],
	"exclude": ["node_modules", "dist", "target"]
}
